#!/usr/bin/env python3
from pathlib import Path
import sys

root = Path(sys.argv[1] if len(sys.argv) > 1 else Path(__file__).resolve().parents[2])

def text(rel):
    return (root / rel).read_text(encoding='utf-8')

makefile = text('kernel/Makefile')
kernel = text('kernel/src/core/titan_kernel.c')
scheduler = text('kernel/src/services/titan_storage_scheduler.c')
shell = text('kernel/src/ui/titan_shell_scene.c')
wireless = text('kernel/src/services/titan_wireless_accessories.c')
bt = text('kernel/src/services/titan_bluetooth_runtime.c')
bridge = text('kernel/src/services/titan_pademu_input_bridge.c')
trace = text('kernel/src/services/titan_health_trace.c')
header = text('kernel/src/services/titan_health_trace.h')
decoder = text('tools/decode_health_freeze_trace.py')

checks = {
    'health trace linked': 'src/services/titan_health_trace.o' in makefile,
    'health trace init': 'TitanHealthTrace_Initialize();' in kernel,
    'five-frame startup flush': 'context.frame_count % 5u' in kernel and 'TitanHealthTrace_RequestFlush();' in kernel,
    'render boundaries': all(x in kernel for x in (
        'TITAN_HT_VIDEO_BEGIN_ENTER','TITAN_HT_SHELL_RENDER_ENTER','TITAN_HT_VIDEO_END_ENTER')),
    'service boundaries': all(x in kernel for x in (
        'TITAN_HT_STORAGE_ENTER','TITAN_HT_NETWORK_ENTER','TITAN_HT_ASSET_ENTER','TITAN_HT_BROWSER_ENTER')),
    'health transition critical': 'TITAN_HT_STARTUP_HEALTH_TRANSITION' in shell,
    'wireless boundary critical': all(x in wireless for x in (
        'TITAN_HT_WIRELESS_BT_REQUEST_BEFORE','TITAN_HT_WIRELESS_BOOTSTRAP_BEFORE','TITAN_HT_WIRELESS_BOND_BEFORE')),
    'bt module exec critical': all(x in bt for x in (
        'TITAN_HT_BT_SMSUTILS_EXEC_BEFORE','TITAN_HT_BT_PADEMU_EXEC_BEFORE','TITAN_HT_BT_PADEMU_EXEC_AFTER')),
    'bt bind critical': 'TITAN_HT_BT_BIND_BEFORE' in bridge and 'TITAN_HT_BT_BIND_AFTER' in bridge,
    'bootstrap rpc critical': 'TITAN_HT_WIRELESS_RPC_BEFORE' in bridge and 'TITAN_PADEMU_WIRELESS_BOOTSTRAP' in bridge,
    'worker-owned persistence': 'TitanHealthTrace_StorageWorkerPump();' in scheduler,
    'audio outranks trace': scheduler.index('TitanStorageScheduler_PumpAudioRealtime();') < scheduler.index('TitanHealthTrace_HasStorageWork()'),
    'ee interrupt api': 'CpuSuspendIntr' not in trace and 'CpuResumeIntr' not in trace and trace.count('intr_state = DIntr();') == 3 and trace.count('if (intr_state != 0)') == 3 and trace.count('EIntr();') == 3,
    'bounded critical wait': 'TITAN_HEALTH_TRACE_CRITICAL_WAIT_MS 180u' in trace,
    'binary trace path': 'health-freeze-trace.bin' in trace,
    'last beacon path': 'health-freeze-last.txt' in trace,
    '1024 event ring': 'TITAN_HEALTH_TRACE_CAPACITY 1024u' in trace,
    'stable code enum': 'TITAN_HT_BT_PADEMU_EXEC_BEFORE' in header,
    'offline decoder': 'BT_PADEMU_EXEC_BEFORE' in decoder and "struct.Struct('<IIIHHIII')" in decoder,
    'chronological ring decoder': 'rows.sort(key=lambda row: row[0])' in decoder,
    'network bootstrap decoder': 'NETWORK_PS2IP_INIT_BEFORE' in decoder and 'NETWORK_MODULE_EXEC_BEFORE' in decoder,
}

failed = [name for name, ok in checks.items() if not ok]
for name, ok in checks.items():
    print(f'{name}: {"PASS" if ok else "FAIL"}')
if failed:
    raise SystemExit('RC5.2 health trace contract failed: ' + ', '.join(failed))
print('rc5.2-health-freeze-flight-recorder: PASS')
